# Portunus configuration. Copy this file to .env and fill it in:
#
#   cp .env.example .env
#
# Precedence: command-line flag > this file > shell environment. The file beats
# the shell, so a stale `export` cannot override an edited file. Set
# PORTUNUS_ENV_FILE in the environment to read a different file.
#
# Format: KEY=VALUE, one per line. Comments are whole lines starting with '#';
# a '#' after the '=' is part of the value. Quotes are optional. An empty value
# means "use the default".
#
# The repository is public: keep real addresses, numbers and passwords in .env
# only, which is gitignored. The examples use the 192.0.2.0/24 documentation
# range.

# What to do with an answered call: echo, greet, listen or agent.
# `make echo`, `make greet`, `make listen` and `make agent` force the mode
# with -mode.
PORTUNUS_MODE=echo

# debug, info, warn or error. Full caller numbers appear only at debug.
PORTUNUS_LOG_LEVEL=info

# --- SIP: the dedicated extension on the Yeastar S20 ---

# The S20's LAN address, optionally with a port (default 5060). It must be a
# private address unless PORTUNUS_ALLOW_PUBLIC_REGISTRAR=true.
PORTUNUS_SIP_REGISTRAR=192.0.2.10

# The extension number Portunus registers as.
PORTUNUS_SIP_EXTENSION=

# The extension's Registration Name, used for digest auth. Empty means the
# extension number.
PORTUNUS_SIP_AUTH_USER=

# The extension's Registration Password. The log shows only its fingerprint;
# to check that the intended password is the one in effect, compare with:
#   printf '%s' 'the-password' | shasum -a 256 | cut -c1-8
PORTUNUS_SIP_PASSWORD=

# The local address to listen on. Empty means detect it from the route to the
# registrar, which is right unless this host has several LAN addresses.
PORTUNUS_SIP_BIND_ADDR=

# The local SIP port (UDP).
PORTUNUS_SIP_PORT=5060

# Local RTP port range, inclusive. Each call takes two ports (RTP and RTCP).
# The firewall between this host and the S20 must allow it.
PORTUNUS_RTP_PORT_MIN=20000
PORTUNUS_RTP_PORT_MAX=20099

# --- Limits ---

# Calls beyond this get 486 Busy Here, and the S20 forwards them to its
# fallback (configure When Busy on the extension).
PORTUNUS_MAX_CONCURRENT_CALLS=2

# How long to ring before answering, as a Go duration (0s, 500ms, 2s). The S20
# already decides when a call reaches Portunus, so the default is 0s.
PORTUNUS_RING_DELAY=0s

# Allow a registrar outside the private address ranges. Leave it false.
PORTUNUS_ALLOW_PUBLIC_REGISTRAR=false

# --- Speech synthesis (greet mode and later) ---

# The TTS server: anything that speaks the OpenAI-style /v1/audio/speech API.
# The default is the local Kokoro started by `make tts-up`. A server outside
# this host or the LAN is a warning at startup, because text sent to it
# leaves the office.
PORTUNUS_TTS_URL=http://127.0.0.1:8880
PORTUNUS_TTS_MODEL=kokoro
# if_sara is Kokoro's female Italian voice (im_nicola is the male one).
PORTUNUS_TTS_VOICE=if_sara

# How much audio may queue ahead of the phone line. It must hold a whole
# reply; on overflow the oldest audio is dropped.
PORTUNUS_OUTPUT_BUFFER=10s

# The text spoken in greet mode. Start from the example:
#   cp prompts/example.greeting.txt prompts/greeting.txt
# prompts/ is ignored by git, so the real text can name the office.
PORTUNUS_GREETING_FILE=prompts/greeting.txt

# --- Speech recognition (listen mode and later) ---

# The STT server: anything that speaks the OpenAI-style
# /v1/audio/transcriptions API. The default is the local Whisper started by
# `make stt-up`. A server outside this host or the LAN is a warning at
# startup, because the callers' voice sent to it leaves the office.
PORTUNUS_STT_URL=http://127.0.0.1:8890
# Sent as the "model" field. whisper.cpp ignores it (its model is fixed when
# the server starts); other compatible servers need it.
PORTUNUS_STT_MODEL=large-v3-turbo
# Longer speech is cut into pieces of at most this length, 2s to 29s. It must
# fit the server's input window: deploy/compose.yaml runs Whisper with
# --audio-ctx 512, about 10 s. With Whisper's full window it could be 25s.
PORTUNUS_STT_MAX_UTTERANCE=9.5s

# Silero's speech probability at which an utterance starts, from 0.1 to 0.95.
# Raise it if the handset's echo of the assistant is heard as the caller.
PORTUNUS_VAD_THRESHOLD=0.5

# How long the caller must pause for an utterance to end, 200ms to 3s. Every
# turn waits this long before transcription starts: lower means snappier,
# but a pause mid-sentence may then cut the sentence in two.
PORTUNUS_VAD_SILENCE=700ms

# --- The conversation (agent mode) ---

# The Anthropic API key, required in agent mode only. Create it in the
# Anthropic Console in a workspace used only by Portunus, with a monthly spend
# limit. The log shows only its fingerprint.
ANTHROPIC_API_KEY=

# The model. A fast Haiku-class model: on the phone, latency beats eloquence.
PORTUNUS_LLM_MODEL=claude-haiku-5-5

# Cost ceiling per reply, thinking included, from 256 to 8192 tokens.
PORTUNUS_LLM_MAX_TOKENS=1024

# Let the model reason before answering: maybe better answers, surely more
# silence before the first word. Off by default.
PORTUNUS_LLM_THINKING=false

# Cost ceilings per call. Either one ends the call gracefully, with a closing
# line and then BYE, never mid-sentence. (A turn stuck 30 s past the time
# ceiling is cut: that backstop is not a setting.)
PORTUNUS_MAX_CALL_TIME=5m
PORTUNUS_MAX_TURNS=20

# The office's time zone, for the date and time the model is told. It does
# not follow the host's, so a VM set to UTC cannot make the assistant give
# callers the wrong time.
PORTUNUS_TIME_ZONE=Europe/Rome

# The texts of the agent mode. Start from the examples:
#   cp prompts/example.system.txt prompts/system.txt
#   cp prompts/example.agent-greeting.txt prompts/agent-greeting.txt
# The holding phrases file is optional; without it the defaults apply.
# The system prompt must be treated as public: nothing a caller must not hear
# goes in it.
PORTUNUS_SYSTEM_PROMPT_FILE=prompts/system.txt
PORTUNUS_AGENT_GREETING_FILE=prompts/agent-greeting.txt
PORTUNUS_HOLDING_FILE=prompts/holding.txt
