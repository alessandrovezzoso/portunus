# Portunus configuration. Copy this file to .env and fill it in:
#
#   cp .env.example .env
#
# Precedence: command-line flag > this file > shell environment. The file beats
# the shell, so a stale `export` cannot override an edited file. Set
# PORTUNUS_ENV_FILE in the environment to read a different file.
#
# Format: KEY=VALUE, one per line. Comments are whole lines starting with '#';
# a '#' after the '=' is part of the value. Quotes are optional. An empty value
# means "use the default".
#
# The repository is public: keep real addresses, numbers and passwords in .env
# only, which is gitignored. The examples use the 192.0.2.0/24 documentation
# range.

# What to do with an answered call: echo, greet, listen or agent.
# Only echo exists in milestone 0. `make echo` forces it with -mode.
PORTUNUS_MODE=echo

# debug, info, warn or error. Full caller numbers appear only at debug.
PORTUNUS_LOG_LEVEL=info

# --- SIP: the dedicated extension on the Yeastar S20 ---

# The S20's LAN address, optionally with a port (default 5060). It must be a
# private address unless PORTUNUS_ALLOW_PUBLIC_REGISTRAR=true.
PORTUNUS_SIP_REGISTRAR=192.0.2.10

# The extension number Portunus registers as.
PORTUNUS_SIP_EXTENSION=

# The extension's Registration Name, used for digest auth. Empty means the
# extension number.
PORTUNUS_SIP_AUTH_USER=

# The extension's Registration Password. The log shows only its fingerprint;
# to check that the intended password is the one in effect, compare with:
#   printf '%s' 'the-password' | shasum -a 256 | cut -c1-8
PORTUNUS_SIP_PASSWORD=

# The local address to listen on. Empty means detect it from the route to the
# registrar, which is right unless this host has several LAN addresses.
PORTUNUS_SIP_BIND_ADDR=

# The local SIP port (UDP).
PORTUNUS_SIP_PORT=5060

# Local RTP port range, inclusive. Each call takes two ports (RTP and RTCP).
# The firewall between this host and the S20 must allow it.
PORTUNUS_RTP_PORT_MIN=20000
PORTUNUS_RTP_PORT_MAX=20099

# --- Limits ---

# Calls beyond this get 486 Busy Here, and the S20 forwards them to its
# fallback (configure When Busy on the extension).
PORTUNUS_MAX_CONCURRENT_CALLS=2

# How long to ring before answering, as a Go duration (0s, 500ms, 2s). The S20
# already decides when a call reaches Portunus, so the default is 0s.
PORTUNUS_RING_DELAY=0s

# Allow a registrar outside the private address ranges. Leave it false.
PORTUNUS_ALLOW_PUBLIC_REGISTRAR=false
